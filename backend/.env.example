# POLARIS AI backend configuration
# Never commit real secrets to GitHub.

CORS_ORIGINS=http://localhost:5173

# USNIC Antarctic iceberg feed. This is public; normally leave unchanged.
USNIC_ANTARCTIC_ICEBERGS_URL=https://usicecenter.gov/File/DownloadCurrent?pId=134

# Copernicus Data Space OAuth client
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Copernicus Marine Toolbox account
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
COPERNICUS_MARINE_DATASET_ID=cmems_mod_glo_phy-cur_anfc_0.083deg_P1D-m

# Optional AIS/vessel provider endpoint. Keep provider credentials server-side.
VESSEL_API_URL=
VESSEL_API_KEY=
